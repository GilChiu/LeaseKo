# ─────────────────────────────────────────────────────────────
# LeaseKo Web App — Environment Variables
# Copy to apps/web/.env.local and fill in your values
# ─────────────────────────────────────────────────────────────

# NestJS API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────
# Clerk Authentication
# Obtain from https://dashboard.clerk.com → your app → API Keys
# ─────────────────────────────────────────────────────────────

# Safe to expose in browser — embedded in the JS bundle
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# SERVER-SIDE ONLY — never assign to NEXT_PUBLIC_
# Used by @clerk/nextjs/server auth() in Server Components
CLERK_SECRET_KEY=
