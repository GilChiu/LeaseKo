# ─────────────────────────────────────────────
# LeaseKo API — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

PORT=3001
NODE_ENV=development

# PostgreSQL (provided by Docker — see infra/docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leaseKo

# Redis (provided by Docker — see infra/docker-compose.yml)
REDIS_URL=redis://localhost:6379

# CORS — Next.js dev server origin
CORS_ORIGIN=http://localhost:3000
