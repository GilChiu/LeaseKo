# ─────────────────────────────────────────────
# LeaseKo API — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3001

# PostgreSQL (provided by Docker — see infra/docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leaseKo

# Redis (provided by Docker — see infra/docker-compose.yml)
REDIS_URL=redis://localhost:6379

# CORS — Next.js dev server origin
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────────────
# Clerk Authentication
# Obtain from https://dashboard.clerk.com → your app → API Keys
# ─────────────────────────────────────────────────────

# REQUIRED — SERVER-SIDE ONLY. Never expose to frontend. App fails to start if missing.
CLERK_SECRET_KEY=

# Optional — auto-derived from CLERK_SECRET_KEY. Set only for private-network overrides.
CLERK_JWKS_URL=

# Optional — JWT issuer validation (multi-domain Clerk setups only)
CLERK_ISSUER=

# Optional — JWT audience validation (audience-restricted setups only)
CLERK_AUDIENCE=
