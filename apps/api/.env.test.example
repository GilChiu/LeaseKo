# ─────────────────────────────────────────────────────────────────────
# LeaseKo API — Test Environment Variables
# Copy this file to .env.test for local test runs:
#   Copy-Item apps/api/.env.test.example apps/api/.env.test
#
# DO NOT commit .env.test — it is gitignored.
# DO NOT use real production credentials here.
#
# Unit tests do NOT read these values at runtime — they mock all
# external dependencies (Prisma, Clerk, Redis) via jest.fn().
#
# The e2e health test bootstraps a minimal module that injects env
# vars directly; it does not require a running database or Redis.
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=test
PORT=3002
FRONTEND_URL=http://localhost:3000

# Test database — only required for future database integration tests.
# Not used by current unit tests or the health e2e test.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leaseKo_test

# Redis — only required for future queue integration tests.
# Not used by current unit tests or the health e2e test.
REDIS_URL=redis://localhost:6379

# Clerk — placeholder values only.
# Unit tests mock Clerk verification and never call the Clerk API.
# Never put real production keys here.
CLERK_SECRET_KEY=test_sk_placeholder
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
